#!/usr/bin/env bash
#
# Git pre-merge-commit hook: a merge commit git records itself on main runs the documentation
# checks first.
#
# A branch commits freely and a push waits for green checks (AGENTS.md, sections 5 and 6), but a
# merge commit git records itself runs neither pre-commit nor pre-push. Git runs this hook after
# the merge succeeded and before it records the commit, with the merged result in the working
# tree; a 'git pull' of a diverged main records its merge commit the same way and runs it too.
# When the checkout is on main, it runs scripts/check-docs.sh and
# scripts/sensor-plan-frontier.sh on that result and refuses the merge while either fails or is
# missing, naming it; together they take about half a minute. A fast-forward and a rebase record
# no merge commit and run no hook, and the project accepts that, so the clone sets no 'merge.ff'.
# A merge that stops on a conflict is recorded by 'git commit', which pre-commit refuses on main.
# Enabled through 'git config core.hooksPath .githooks', which the Dev Container sets on creation
# (.devcontainer/devcontainer.json); outside it, run that command once per clone.
#
# Bypassable with 'git merge --no-verify'. scripts/test-git-hooks.sh exercises this hook.

set -uo pipefail

[[ "$(git symbolic-ref -q HEAD 2>/dev/null || true)" == "refs/heads/main" ]] || exit 0

root="$(git rev-parse --show-toplevel)" || exit 1
# Git hands the hook its own repository variables, GIT_DIR and GIT_INDEX_FILE among them, with
# absolute paths in a linked worktree. A check that runs git elsewhere, such as in a fixture
# repository, would act on this one, so the checks run without them and find the repository from
# their own directory.
# shellcheck disable=SC2046  # one variable name per word is what unset takes
unset $(git rev-parse --local-env-vars)

failed=()
for check in scripts/check-docs.sh scripts/sensor-plan-frontier.sh; do
  if [[ ! -f "$root/$check" ]]; then
    echo "pre-merge-commit: $check is missing from the merged result." >&2
    failed+=("$check")
    continue
  fi
  bash "$root/$check" || failed+=("$check")
done

if ((${#failed[@]})); then
  echo >&2
  echo "pre-merge-commit: refused — ${failed[*]} failed or is missing on the merged result, and main takes no red merge (AGENTS.md, section 5). Run 'git merge --abort', fix the branch, and merge again." >&2
  exit 1
fi

exit 0
