{
  "name": "Comb DevContainer",

  // Built from the Dockerfile beside this file: the base image and Bun, pinned by digest
  // (ADR-0014).
  "build": { "dockerfile": "Dockerfile" },
  // No workspaceFolder or workspaceMount: the default, /workspaces/<directory name>, keeps each
  // project under a path of its own, and an agent keys its memory by the path (ADR-0004).

  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // The host's agent config directory, and the host's ~/.config/gh, where the GitHub CLI keeps
  // the login made by `gh auth login`, so that it outlives a rebuild
  // (ADR-draft-gh-login-outlives-a-rebuild). HOME is set on Linux and macOS, USERPROFILE on
  // Windows; exactly one of the two is non-empty, so concatenating both yields the home directory
  // on every host (the pattern the Dev Containers documentation recommends).
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh,target=/home/vscode/.config/gh,type=bind"
  ],

  // The host's address on the Docker bridge, by which the benchmark reaches a Chrome on the host
  // that a forwarder there bridges to its debugging port (ADR-0028). And a limit of 8192 tasks,
  // threads included, in place of Podman's default of 2048: one `CI=1 scripts/check-all.sh` peaks
  // at about 1400, most of it the Playwright workers' Chromium, so two worktrees running the checks
  // at once need about 2800 beside the editor and the agents, and 8192 leaves room for a third.
  // The limit takes effect when the container is rebuilt.
  "runArgs": ["--add-host=host.docker.internal:host-gateway", "--pids-limit=8192"],

  "shutdownAction": "stopContainer",

  // Runs on the host before the container is created. Ensures the bind-mount sources exist, so
  // Docker does not auto-create them as root-owned directories (which breaks credential writes
  // inside the container). Written to work in both a POSIX shell and cmd.exe: one plain `mkdir`
  // per directory, parent first (cmd.exe knows no `-p`, and ~/.config may not exist yet); each in
  // parentheses with `|| cd .`, a no-op that succeeds in both shells, so an already existing
  // directory — an error for both — neither aborts the chain nor the container build; and a
  // final `exit 0`, so the command's exit code is 0 in cmd.exe too, whose error level a failed
  // `mkdir` may have left set.
  "initializeCommand": "(mkdir \"${localEnv:HOME}${localEnv:USERPROFILE}/.claude\" || cd .) && (mkdir \"${localEnv:HOME}${localEnv:USERPROFILE}/.config\" || cd .) && (mkdir \"${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh\" || cd .) && exit 0",

  // Runs inside the container on every start, so the settings are set again should a session
  // have changed them: the repository's git hooks under .githooks/ and the merge settings they
  // rely on, and gh as git's credential helper for github.com, which --force sets up while
  // nobody is logged in (ADR-draft-gh-login-outlives-a-rebuild). What each hook refuses, and the
  // same commands for a clone outside the container, are under "Git hooks" in CONTRIBUTING.md.
  "postStartCommand": {
    "hooks": "git config core.hooksPath .githooks",
    "merge": "git config merge.ff false && git config pull.ff only",
    "index": "git config merge.adr-index.driver '.githooks/merge-adr-index %O %A %B %S %X %Y'",
    "credentials": "gh auth setup-git --hostname github.com --force"
  },

  // Runs inside the container once it is created. The dependencies come from bun.lock;
  // Playwright's installer adds Chromium and its system libraries for the browser tests
  // (ADR-0008). ShellCheck comes with the image (Dockerfile).
  "postCreateCommand": {
    "deps": "bun install --frozen-lockfile && bunx --bun playwright install --with-deps chromium"
  },

  // DevContainer Features layered on top of the image. The container intentionally has NO access
  // to any container engine (no socket mount, no engine inside) — see ADR-0004 and ADR-0015.
  // Manage the host's containers from a host-side VS Code extension instead (CONTRIBUTING.md →
  // "Host container management").
  "features": {
    // GitHub CLI (`gh`) — used by the coding agent for GitHub operations and as the git
    // credential helper. A push and every gh action wait for a human instruction
    // (AGENTS.md, section 6).
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Rust stable with the WebAssembly target for the engine (ADR-0014).
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "targets": "wasm32-unknown-unknown",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    }
  },

  "customizations": {
    // VS Code extensions installed inside the container
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "ms-playwright.playwright",
        "oven.bun-vscode"
      ]
    }
  },

  // The example's development server (G-9), which the launch configuration opens in the host's
  // browser, and the benchmark's preview server, which a Chrome on the host loads (ADR-0028).
  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Comb example", "onAutoForward": "silent" },
    "4173": { "label": "Comb benchmark", "onAutoForward": "silent" }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
