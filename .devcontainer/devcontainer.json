{
  "name": "Comb DevContainer",

  // Built from the Dockerfile beside this file: the base image and Bun, pinned by digest
  // (ADR-0014).
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // The host's agent config directory. HOME is set on Linux and macOS, USERPROFILE on Windows;
  // exactly one of the two is non-empty, so concatenating both yields the home directory on every
  // host (the pattern the Dev Containers documentation recommends).
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind"
  ],

  "shutdownAction": "stopContainer",

  // Runs on the host before the container is created. Ensures the bind-mount source for the agent
  // config exists, so Docker does not auto-create it as a root-owned directory (which breaks
  // credential writes inside the container). Written to work in both a POSIX shell and cmd.exe:
  // plain `mkdir` (cmd.exe knows no `-p`; the parent is the home directory and always exists) and
  // `|| exit 0` so an already existing directory — an error for both shells — does not abort the
  // container build.
  "initializeCommand": "mkdir \"${localEnv:HOME}${localEnv:USERPROFILE}/.claude\" || exit 0",

  // Runs inside the container once it is created. Git does not version its hooks, so the
  // repository keeps them under .githooks/ and this points git at them: pre-commit refuses a
  // commit on main (AGENTS.md, section 6), pre-push runs the checks first (AGENTS.md, section 5).
  // Outside the container, run the same command once per clone (README → "Getting Started").
  // The dependencies come from bun.lock; Playwright's installer adds Chromium and its system
  // libraries for the browser tests (ADR-0008).
  "postCreateCommand": {
    "hooks": "git config core.hooksPath .githooks",
    "deps": "bun install --frozen-lockfile && bunx --bun playwright install --with-deps chromium"
  },

  // DevContainer Features layered on top of the image. The container intentionally has NO access
  // to any container engine (no socket mount, no engine inside) — see ADR-0004 and ADR-0015.
  // Manage the host's containers from a host-side VS Code extension instead (README → "Host
  // container management").
  "features": {
    // GitHub CLI (`gh`) — used by the coding agent for GitHub operations and as the git
    // credential helper. A push and every gh action wait for a human instruction
    // (AGENTS.md, section 6).
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Node.js — only the fallback runtime for Playwright while Bun runs it (ADR-0008, ADR-0014).
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "none"
    },
    // Rust stable with the WebAssembly target for the engine (ADR-0014).
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "targets": "wasm32-unknown-unknown",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    }
  },

  "customizations": {
    // VS Code extensions installed inside the container
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "ms-playwright.playwright",
        "oven.bun-vscode"
      ]
    }
  },

  // The example's development server (G-9); the launch configuration opens it in the host's
  // browser.
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Comb example", "onAutoForward": "silent" }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
